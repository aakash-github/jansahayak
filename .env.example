# copy to backend/.env  (never commit the real one)

# Course LLM (Qwen3-8B) - your group's row in the Track B guide
MODEL_BASE_URL=https://103.42.50.41:103X/v1
MODEL_NAME=Qwen/Qwen3-8B
MODEL_API_KEY=
MODEL_CA_CERT_PATH=C:/Users/you/Downloads/vm0X-ca.crt

# Course embedding API (VM02) - see docs/RAG_AND_EMBEDDINGS.md
EMBED_BASE_URL=https://103.42.50.41:1035/v1
EMBED_MODEL=bge-small-en-v1.5
EMBED_API_KEY=
EMBED_CA_CERT_PATH=C:/Users/you/Downloads/vm02-ca.crt
# Model compliance (docs/MODEL_COMPLIANCE.md):
# EMBED_LOCAL_FALLBACK=1   # offline laptop work ONLY: run bge-small locally if the API is down (off by default;
#                          # eval/run_eval.py refuses to run with it on)
# RERANKER=off             # turn off the MiniLM reranker (not an IIT KGP model); default on
# MAX_CHUNKS_PER_DOC=2     # evidence variety: at most N of the 4 evidence chunks from one PDF; 0 = no cap
# REQUIRE_REAL_LLM=1       # refuse to start without the real Qwen3-8B (automatic on Render)

FRONTEND_ORIGIN=http://localhost:5173,https://<your-github-username>.github.io

# Tracing (see docs/EVALUATION.md)
# TRACE_FILE=logs/traces.jsonl          # also save request traces to a file
# LANGSMITH_TRACING=true                # optional LangSmith dashboard (sends message text to LangSmith)
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=jansahayak
